# Base URL of the CHABA API (apps/api). Used for server- and client-side fetches.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public base URL of the storefront itself (apps/web). Used to build absolute
# URLs for SEO metadata (Open Graph, hreflang alternates, sitemap).
# TODO: set to the real production domain once one is chosen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp contact number for the storefront's floating contact button, in
# international format digits only (no "+", no spaces, e.g. 213555000000).
# TODO: set to the real CHABA support WhatsApp number. Leave empty to hide
# the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Error tracking (@sentry/nextjs, instrumentation.ts / instrumentation-client.ts).
# Both SDKs are a no-op until a real DSN is set — leave blank in dev.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Google Search Console ownership verification token (Search Console →
# Settings → Ownership verification → HTML tag → the "content" value only).
# TODO: set once the site is added to Search Console. Leave empty to omit
# the verification meta tag entirely.
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 measurement ID (starts with "G-"). Storefront-only, not
# loaded on /admin. TODO: set once a GA4 property exists. Leave empty to
# skip loading GA4 entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
