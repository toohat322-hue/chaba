APP_NAME=CHABA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Algiers

# ar is the default/primary locale (RTL-first), not a fallback of en/fr.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=chaba
DB_USERNAME=chaba
DB_PASSWORD=chaba

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=chaba_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev uses Mailhog (SMTP catch-all at localhost:1025, UI at localhost:8025).
# Production mailer/SMS provider are decided at Phase 2 (Authentication/OTP).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@chaba.dz"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage. Local dev points at the MinIO container;
# production values (real S3/Spaces/Scaleway credentials + endpoint) are a later decision.
AWS_ACCESS_KEY_ID=chaba_minio
AWS_SECRET_ACCESS_KEY=chaba_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=chaba-local
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Frontend origin allowed to call this API (CORS). Overridden per environment.
FRONTEND_URL=http://localhost:3000

# 'log' writes OTPs/SMS to the log and a dev inbox (visible in Mailhog) so
# auth is testable with zero external setup. Set SMS_DRIVER=twilio and fill
# in the TWILIO_* values below to send real SMS through Twilio.
SMS_DRIVER=log
SMS_DEV_INBOX=otp-dev@chaba.dz
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Online payment gateways (Phase 6). No merchant credentials/API docs exist
# for either yet — leave *_ENABLED=false until real values are available.
CIB_ENABLED=false
CIB_MERCHANT_ID=
CIB_API_KEY=
CIB_SECRET=
CIB_BASE_URL=

EDAHABIA_ENABLED=false
EDAHABIA_MERCHANT_ID=
EDAHABIA_API_KEY=
EDAHABIA_SECRET=
EDAHABIA_BASE_URL=

# Social login (Google/Facebook/Apple). No app credentials exist yet — leave
# *_ENABLED=false until real values are available. See
# docs/social-login-setup.md for how to obtain each one and exactly which
# redirect URI to register with each provider.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback

APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Dev-only seeded Super Admin (AdminUserSeeder) — never used in production.
ADMIN_SEED_PHONE=0555000000
ADMIN_SEED_PASSWORD=ChangeMe123!

# Error tracking (sentry/sentry-laravel, config/sentry.php). SDK is a no-op
# until a real DSN is set — leave blank in dev.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.2

# Backups (spatie/laravel-backup, config/backup.php). 'local' works with zero
# setup; add ",s3" once a real off-server target is wanted (reuses the AWS_*
# MinIO/S3 credentials above).
BACKUP_DISKS=local

VITE_APP_NAME="${APP_NAME}"
