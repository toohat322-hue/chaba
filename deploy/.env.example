# Server-level settings for deploy/docker-compose.yml.
# install.sh copies this to .env and fills in the hosts and the password.

# Public hostnames. With no domain yet, install.sh uses free sslip.io names
# built from the server's IP (e.g. chaba-1-2-3-4.sslip.io), which resolve to
# that IP and get real HTTPS certificates. When you buy a domain, point its
# DNS at the server, change these two lines, and run deploy.sh again.
WEB_HOST=
API_HOST=

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=

# Database password (generated by install.sh).
POSTGRES_PASSWORD=

# --- Storefront build settings (baked in at build time) ---
# The R2 bucket's public URL, same value as AWS_URL in api.env.
NEXT_PUBLIC_ASSET_URL=
# WhatsApp number for the /contact page, digits only (no "+").
NEXT_PUBLIC_WHATSAPP_NUMBER=213553189978
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
