# Laravel settings for the API, queue worker and scheduler.
# install.sh copies this to api.env and fills in APP_KEY. Fill in the rest
# yourself (at least the R2 block), then run deploy.sh.
#
# Not here on purpose — docker-compose.yml sets them from deploy/.env:
# APP_URL, FRONTEND_URL, GOOGLE_REDIRECT_URI, DB_*, REDIS_HOST/PORT.

APP_NAME=CHABA
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=Africa/Algiers
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=chaba_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis

# --- Cloudflare R2 (product images, hero slides, nightly backups) ---
# Required. See docs/DEPLOYMENT-HETZNER.md, step 4.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# https://<account_id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# The bucket's public URL, e.g. https://pub-xxxxx.r2.dev
AWS_URL=

# Nightly database + files backup (03:00), stored on R2.
BACKUP_DISKS=s3

# --- SMS (OTP codes). "log" only writes codes to the logs. ---
SMS_DRIVER=log
SMS_DEV_INBOX=otp-dev@chaba.dz
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email. "log" only writes emails to the logs. ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@chaba.dz
MAIL_FROM_NAME=CHABA

# --- Online payment ---
CIB_ENABLED=false
EDAHABIA_ENABLED=false

# --- Social login ---
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_ENABLED=false
APPLE_ENABLED=false

# --- Error tracking (optional) ---
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
